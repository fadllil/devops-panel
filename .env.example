# ==============================================================================
# DevOps Panel Environment Configuration (Template)
# ==============================================================================

# URL endpoint REST API backend devops-service
# - Pilihan 1: URL absolut ke backend server
VITE_API_URL=http://localhost:8080/api
# - Pilihan 2: Relative path via proxy internal Vite (disarankan saat development lokal)
# VITE_API_URL=/api

# Target backend untuk proxy development Vite (jika menggunakan /api)
VITE_API_TARGET=http://localhost:8080

# Timeout request HTTP dalam milidetik (default: 30000 / 30 detik)
VITE_API_TIMEOUT=30000

# Judul Tab & Nama Aplikasi
VITE_APP_TITLE="DevOps Panel - OpenVPN Management"

# Port Server Development Vite (default: 5173)
VITE_PORT=5173

# Tema default sebelum user memilih ("dark" atau "light")
VITE_DEFAULT_THEME=dark
